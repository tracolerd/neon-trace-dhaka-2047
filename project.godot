; NEON//TRACE: DHAKA 2047
; Godot 4.x project configuration
config_version=5

[application]
config/name="NEON//TRACE: DHAKA 2047"
config/description="A focused third-person cyber-investigation thriller set in a fictionalized Dhaka, 2047."
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
EventBus="*res://scripts/core/event_bus.gd"
GameManager="*res://scripts/core/game_manager.gd"
SettingsManager="*res://scripts/core/settings_manager.gd"
SaveManager="*res://scripts/core/save_manager.gd"
SceneManager="*res://scripts/core/scene_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

environment/defaults/default_clear_color=Color(0.015, 0.02, 0.035, 1)

[physics]
3d/default_gravity=18.0

[input]
move_forward={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":87)]}
move_backward={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194325)]}
crouch={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194326)]}
jump={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":32)]}
interact={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":69)]}
scanner={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":81)]}
inventory={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194309)]}
pause={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194305)]}
camera_left={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194311)]}
camera_right={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194313)]}
camera_up={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194310)]}
camera_down={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194312)]}

[gui]
theme/default_font_multichannel_signed_distance_field=true

[debug]
settings/stdout/print_fps=false
